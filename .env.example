# --- Postgres ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar
DATABASE_URL=postgresql+psycopg://radar:radar@postgres:5432/radar

# --- GitHub ---
# Personal access token (classic or fine-grained). Server-side only, never exposed to frontend.
# Empty = demo/seed mode only (no live GitHub calls).
GITHUB_TOKEN=
# Comma-separated fallback tokens for higher rate limits (optional)
GITHUB_TOKENS=

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=60
DISCOVERY_INTERVAL_MINUTES=30
SCORING_INTERVAL_MINUTES=15
RANKING_INTERVAL_MINUTES=15

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to "true" to serve clearly-labeled demo data without a GitHub token
NEXT_PUBLIC_DEMO=false

# --- TimescaleDB (optional) ---
# Set POSTGRES_IMAGE=timescale/timescaledb:latest-pg16 to enable hypertables
POSTGRES_IMAGE=postgres:16-alpine
