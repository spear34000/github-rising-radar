# GitHub Rising Radar — API service image.
# Build context is the repository root (see docker-compose.yml).
# NOTE: packages/schemas and packages/scoring are built by sibling workstreams;
# they must exist in the build context before building this image.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv

COPY packages/schemas /srv/packages/schemas
COPY packages/scoring /srv/packages/scoring
COPY apps/api /srv/apps/api

RUN pip install /srv/packages/schemas /srv/packages/scoring /srv/apps/api

WORKDIR /srv/apps/api

EXPOSE 8000

# Run migrations, then serve. DATABASE_URL comes from the environment.
CMD ["sh", "-c", "alembic upgrade head && uvicorn radar_api.main:app --host 0.0.0.0 --port 8000"]
